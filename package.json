{
  "name": "notification-service",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/server.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "dev": "bun run --hot src/server.ts",
    "new-migration": "bunx drizzle-kit generate --dialect sqlite --schema src/database/schema.ts",
    "migrate": "bun run scripts/migrate.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.4"
  }
}
